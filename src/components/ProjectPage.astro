---
import Base from '../layouts/Base.astro';
import { render, type CollectionEntry } from 'astro:content';
import { useTranslations, localePath, type Locale } from '../i18n/utils';
import { profile } from '../data/profile';

const { project, locale } = Astro.props as { project: CollectionEntry<'projects'>; locale: Locale };
const t = useTranslations(locale);
const { Content, headings } = await render(project);
const d = project.data;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    name: d.title,
    description: d.summary,
    author: { '@type': 'Person', name: profile.name },
    inLanguage: locale,
    keywords: d.stack.join(', '),
    ...(d.url ? { url: d.url } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t('nav.home'), item: new URL(localePath(locale, '/'), Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: t('nav.projects'), item: new URL(localePath(locale, '/#projects'), Astro.site).toString() },
      { '@type': 'ListItem', position: 3, name: d.title },
    ],
  },
];
---
<Base {locale} title={`${d.title} — ${profile.name}`} description={d.summary} path={`/projects/${d.key}`} type="article" {jsonLd} home={false}>
  <article class="mx-auto max-w-4xl px-5 pb-16 pt-28 md:pt-36">
    <a href={localePath(locale, '/#projects')} class="glass-chip inline-flex items-center gap-2 px-4 py-2 text-sm text-muted transition-colors hover:text-fg">← {t('projects.back')}</a>
    <header class="glass glass-sheen relative mt-6 overflow-hidden p-7 md:p-12" style={`--card-accent:${d.accent}`} transition:name={`project-${d.key}`}>
      <span aria-hidden="true" class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full opacity-50 blur-3xl" style="background: radial-gradient(circle, var(--card-accent), transparent 65%)"></span>
      <p class="eyebrow">{t('projects.eyebrow')} · {d.year}</p>
      <h1 class="display mt-4 text-4xl md:text-6xl">{d.title}</h1>
      <p class="mt-5 max-w-2xl text-muted md:text-lg">{d.summary}</p>
      <dl class="mt-8 grid gap-6 border-t border-line pt-6 text-sm sm:grid-cols-3">
        <div><dt class="eyebrow">{t('projects.role')}</dt><dd class="mt-2">{d.role}</dd></div>
        <div><dt class="eyebrow">{t('projects.year')}</dt><dd class="mt-2">{d.year}</dd></div>
        <div><dt class="eyebrow">{t('projects.stack')}</dt><dd class="mt-2 flex flex-wrap gap-1.5">{d.stack.map((s) => <span class="glass-chip px-2 py-0.5 font-mono text-[11px]">{s}</span>)}</dd></div>
      </dl>
      {(d.url || d.repo) && (
        <div class="mt-8 flex flex-wrap gap-3">
          {d.url && <a href={d.url} target="_blank" rel="noopener" class="btn-primary">{t('projects.visit')} ↗</a>}
          {d.repo && <a href={d.repo} target="_blank" rel="noopener" class="btn-ghost">{t('projects.source')} ↗</a>}
        </div>
      )}
    </header>

    <div class="mt-6 grid gap-6 lg:grid-cols-[1fr_220px]">
      <div class="glass glass-sheen prose-glass p-7 md:p-12" data-reveal>
        <Content />
      </div>
      {headings.length > 0 && (
        <aside class="hidden lg:block">
          <nav class="glass glass-sheen sticky top-28 p-5" aria-label="On this page">
            <p class="eyebrow">{t('projects.contents')}</p>
            <ul class="mt-3 space-y-2 text-sm">
              {headings.filter((h) => h.depth === 2).map((h) => <li><a href={`#${h.slug}`} class="text-muted transition-colors hover:text-fg">{h.text}</a></li>)}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </article>
</Base>
