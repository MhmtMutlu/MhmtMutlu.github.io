---
/* Chromium-only liquid-glass refraction filter. Referenced via backdrop-filter: url(#lens). */
---
<svg aria-hidden="true" width="0" height="0" style="position:absolute">
  <filter id="lens" x="-10%" y="-10%" width="120%" height="120%" color-interpolation-filters="sRGB">
    <feTurbulence type="fractalNoise" baseFrequency="0.012 0.018" numOctaves="2" seed="7" result="noise" />
    <feGaussianBlur in="noise" stdDeviation="2.5" result="smooth" />
    <feDisplacementMap in="SourceGraphic" in2="smooth" scale="14" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>
