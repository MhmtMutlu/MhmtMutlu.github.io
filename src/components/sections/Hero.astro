---
import HeroScene from '../three/HeroScene.tsx';
import { profile } from '../../data/profile';
import { social } from '../../data/social';
import { useTranslations, type Locale } from '../../i18n/utils';
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
---
<section id="hero" class="relative isolate flex min-h-[100svh] items-end overflow-hidden px-5 pb-24 pt-28 md:items-center md:pb-20">
  <HeroScene client:only="react" />
  <div aria-hidden="true" class="hero-placeholder pointer-events-none absolute inset-0 -z-10">
    <span class="blob"></span>
  </div>
  <div aria-hidden="true" class="hero-scrim pointer-events-none absolute inset-x-0 bottom-0 h-[70%] md:hidden"></div>

  <div class="relative mx-auto w-full max-w-6xl">
    <div class="max-w-3xl">
      <p class="eyebrow hero-in" style="--i:0"><span lang="en">{profile.role}</span> · {locale === 'tr' ? 'İstanbul' : 'Istanbul'}</p>
      <h1 class="display mt-5 text-[17vw] leading-[0.9] sm:text-8xl md:text-9xl lg:text-[9rem]">
        <span class="block hero-in" style="--i:1">{t('hero.title.1')}</span>
        <span class="block hero-in gradient-text" style="--i:2">{t('hero.title.2')}</span>
      </h1>
      <p class="hero-in mt-7 max-w-xl text-base leading-relaxed text-muted md:text-lg" style="--i:3">{t('hero.lead')}</p>
      <div class="hero-in mt-9 flex flex-wrap items-center gap-3" style="--i:4">
        <a href="#projects" class="btn-primary">{t('hero.cta.projects')}</a>
        <a href="#contact" class="btn-ghost">{t('hero.cta.contact')}</a>
        <div class="ml-1 flex items-center gap-1">
          {social.map(({ label, href, icon }) => (
            <a href={href} target="_blank" rel="noopener me" aria-label={label} class="glass-chip grid h-10 w-10 place-items-center text-muted transition-colors hover:text-accent">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icon} />
            </a>
          ))}
        </div>
      </div>
      <p class="hero-in mt-10 hidden font-mono text-xs tracking-wider text-muted md:block" style="--i:5">Angular · TypeScript · Lit · React · Next.js</p>
    </div>
  </div>

  <a href="#about" class="hero-in absolute bottom-24 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 font-mono text-[10px] uppercase tracking-[0.3em] text-muted md:bottom-8 md:flex" style="--i:6" aria-label={t('hero.scroll')}>
    {t('hero.scroll')}
    <span class="scroll-line"></span>
  </a>
</section>

<style>
  .hero-scrim { background: linear-gradient(to top, var(--c-bg) 0%, color-mix(in oklab, var(--c-bg) 80%, transparent) 55%, transparent 100%); }
  .hero-in { opacity: 0; transform: translateY(26px); animation: hero-in 1.1s var(--ease-out-expo) forwards; animation-delay: calc(0.15s + var(--i) * 0.09s); }
  @keyframes hero-in { to { opacity: 1; transform: none; } }
  .scroll-line { width: 1px; height: 44px; background: linear-gradient(var(--c-muted), transparent); position: relative; overflow: hidden; }
  .scroll-line::after { content: ""; position: absolute; inset: 0; background: var(--c-accent); transform: translateY(-100%); animation: scroll-hint 1.8s ease-in-out infinite; }
  @keyframes scroll-hint { to { transform: translateY(100%); } }
  /* Shown until the WebGL scene renders its first frame; stays as the static hero without WebGL or with reduced motion. */
  .hero-placeholder { opacity: 1; transition: opacity .8s ease; }
  :global(.hero-ready) .hero-placeholder { opacity: 0; }
  .blob {
    position: absolute; left: 50%; top: 9%; width: min(62vw, 300px); aspect-ratio: 1; transform: translateX(-50%);
    border-radius: 42% 58% 60% 40% / 45% 40% 60% 55%;
    background:
      linear-gradient(135deg, rgb(255 255 255 / .55), rgb(255 255 255 / .05)),
      linear-gradient(160deg, color-mix(in oklab, var(--c-accent) 28%, transparent), color-mix(in oklab, var(--c-accent-2) 22%, transparent));
    -webkit-backdrop-filter: blur(20px); backdrop-filter: blur(20px);
    border: 1px solid var(--glass-border);
    box-shadow: var(--glass-shadow), 0 0 0 1px color-mix(in oklab, var(--c-accent) 12%, transparent) inset;
    animation: blob-float 7s ease-in-out infinite alternate;
  }
  @media (min-width: 768px) {
    .blob { left: auto; right: 10%; top: 22%; width: min(34vw, 460px); transform: none; }
  }
  @keyframes blob-float {
    from { border-radius: 42% 58% 60% 40% / 45% 40% 60% 55%; }
    to { border-radius: 55% 45% 40% 60% / 50% 60% 40% 50%; transform: translateX(var(--blob-x, -50%)) translateY(-10px) rotate(6deg); }
  }
  @media (min-width: 768px) { .blob { --blob-x: 0; } }
  @media (prefers-reduced-motion: reduce) { .blob { animation: none; } }
  @media (prefers-reduced-motion: reduce) { .hero-in { animation: none; opacity: 1; transform: none; } }
</style>
