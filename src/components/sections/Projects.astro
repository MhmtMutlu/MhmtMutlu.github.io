---
import SectionHeader from '../ui/SectionHeader.astro';
import { getCollection } from 'astro:content';
import { useTranslations, localePath, type Locale } from '../../i18n/utils';
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const projects = (await getCollection('projects', (p) => p.data.locale === locale)).sort((a, b) => a.data.order - b.data.order);
---
<section id="projects" class="mx-auto max-w-6xl scroll-mt-24 px-5 py-20 md:py-32">
  <SectionHeader eyebrow={t('projects.eyebrow')} title={t('projects.title')} />
  <p class="-mt-6 mb-10 max-w-xl text-muted md:-mt-10 md:mb-14" data-reveal>{t('projects.lead')}</p>
  <div class="grid gap-5 md:grid-cols-6">
    {projects.map((p, i) => {
      const spans = ['md:col-span-4', 'md:col-span-2', 'md:col-span-2', 'md:col-span-4', 'md:col-span-3', 'md:col-span-3'];
      const span = spans[i % spans.length];
      return (
        <a
          href={localePath(locale, `/projects/${p.data.key}`)}
          class={`project-card glass glass-sheen group relative flex min-h-[260px] flex-col justify-between overflow-hidden p-6 md:p-8 ${span}`}
          style={`--card-accent:${p.data.accent}`}
          data-reveal
          data-reveal-delay={(i % 3) * 0.07}
          transition:name={`project-${p.data.key}`}
        >
          <span aria-hidden="true" class="card-glow"></span>
          <div class="flex items-start justify-between gap-4">
            <p class="font-mono text-xs text-muted">{p.data.year} · {p.data.role}</p>
            <span class="glass-chip grid h-9 w-9 place-items-center text-muted transition-transform duration-500 group-hover:rotate-45 group-hover:text-fg" style="transition-timing-function: var(--ease-spring)">
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M7 17 17 7M8 7h9v9"/></svg>
            </span>
          </div>
          <div>
            <h3 class="mt-8 text-2xl font-semibold leading-tight md:text-3xl">{p.data.title}</h3>
            <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted md:text-[15px]">{p.data.summary}</p>
            <div class="mt-5 flex flex-wrap gap-1.5">
              {p.data.stack.slice(0, 5).map((s) => <span class="glass-chip px-2 py-0.5 font-mono text-[11px] text-muted">{s}</span>)}
            </div>
          </div>
        </a>
      );
    })}
  </div>
</section>

<style>
  .project-card { transition: transform .5s var(--ease-out-expo), box-shadow .5s; }
  @media (hover: hover) { .project-card:hover { transform: translateY(-4px); } }
  .card-glow {
    position: absolute; inset: auto -20% -40% auto; width: 60%; aspect-ratio: 1; border-radius: 50%;
    background: radial-gradient(circle, color-mix(in oklab, var(--card-accent) 45%, transparent), transparent 65%);
    filter: blur(30px); opacity: .5; transition: opacity .6s, transform .8s var(--ease-out-expo); pointer-events: none; z-index: -1;
  }
  .project-card:hover .card-glow { opacity: .9; transform: scale(1.25) translate(-10%, -10%); }
</style>
