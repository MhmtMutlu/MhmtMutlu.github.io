---
import { profile } from '../../data/profile';
import { social } from '../../data/social';
import { useTranslations, type Locale } from '../../i18n/utils';
const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const year = new Date().getFullYear();
---
<footer class="mx-auto max-w-6xl px-5 pb-28 pt-16 md:pb-16">
  <div class="glass glass-sheen flex flex-col items-start justify-between gap-6 px-6 py-6 md:flex-row md:items-center">
    <div>
      <p class="font-display text-2xl">Mehmet Mutlu</p>
      <p class="mt-1 text-sm text-muted">{t('footer.built')}</p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      {social.map((s) => (
        <a class="glass-chip px-3 py-1.5 text-sm transition-colors hover:text-accent" href={s.href} target="_blank" rel="noopener me">{s.label}</a>
      ))}
      <a class="glass-chip px-3 py-1.5 text-sm hover:text-accent transition-colors" href={`mailto:${profile.email}`}>Email</a>
    </div>
  </div>
  <p class="mt-6 text-center font-mono text-xs text-muted">© {year} Mehmet Mutlu · {t('footer.rights')}</p>
</footer>
